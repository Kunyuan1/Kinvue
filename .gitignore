# Dependencies
node_modules/

# Build outputs
out/
dist/
release/
*.tsbuildinfo

# Environment files — the SmartSpectra API key lives here, never in git
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Captured demo footage used as the live-demo fallback (KV-5). Kept out of git
# on purpose: it is a recording of a real person's face. The demo script says
# to disclose when it is used; committing it would also publish it.
fallback/
*.mp4
*.webm

# Local session data written by the app at runtime (Electron userData). Real
# check-in records — vitals plus answers — so it must never be committed. The
# seeded demo persona is generated by core/seed, not stored here.
sessions/

# Local-only agent and editor instruction files. Useful on a clone, but they
# are personal tooling notes rather than part of the project.
CLAUDE.md
AGENTS.md
.claude/
