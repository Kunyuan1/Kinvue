# Dependencies
node_modules/

# Build outputs
out/
dist/
release/
*.tsbuildinfo

# Environment files — the SmartSpectra API key lives here, never in git
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Recorded capture footage, should any ever exist (KV-5, deliberately dormant).
# Kept out of git on purpose: it is a recording of a real person's face, and
# committing it would publish it. Replaying footage into capture is the closest
# this codebase gets to inventing a vital: see KV-5 for the gate it needs before
# anyone builds it.
fallback/
*.mp4
*.webm

# Local session data written by the app at runtime (Electron userData). Real
# check-in records — vitals plus answers — so it must never be committed. The
# seeded demo persona is generated by core/seed, not stored here.
sessions/

# Local-only agent and editor instruction files. Useful on a clone, but they
# are personal tooling notes rather than part of the project.
CLAUDE.md
AGENTS.md
.claude/
