{
  "name": "kinvue-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A daily check-in that tells a caregiver when an older adult's day looks different from their own baseline.",
  "workspaces": [
    "core",
    "app"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "preview": "npm run preview -w app",
    "dist": "npm run dist -w app",
    "typecheck": "tsc -p core && tsc -p app && tsc -p .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/semver": "^7.8.0",
    "eslint": "^10.14.0",
    "semver": "^7.8.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
